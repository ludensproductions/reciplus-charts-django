# Docker stuff
DOCKER_PORT_OUT=3000
PROJECT_CODENAME=django_template
LOKI_URL=http://set-loki-url-here-if-needed.dev
LOKI_SERVER_TAG=dev-server

# Django Stuff (Generar uno con openssl rand -hex 32 y ponerlo en .env.example)
SECRET_KEY=lel
DEBUG=True
LOG_FILE=False
DEVELOPMENT=True


# Base URL(s) of the application used to configure ALLOWED_HOSTS and CSRF_TRUSTED_ORIGINS. Accepts a single URL or a comma-separated list.
WEB_URL=http://localhost:8000,http://127.0.0.1:8000

# Origenes permitidos para el endpoint de intercambio SSO (donde vive el frontend reciplus-kotlin)
CORS_ALLOWED_ORIGINS=http://localhost:8080

# Database Settings
SQL_HOST=localhost
SQL_PORT=5432
SQL_USER=postgres
SQL_PASSWORD=ludens123
SQL_DBNAME=template_db

# Mail related settings
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=example@example.com
EMAIL_HOST_PASSWORD=xxxxxxxxx
DEFAULT_FROM_EMAIL=example@example.com
PASSWORD_RESET_BASE_URL=http://localhost:8000

# Redis settings
REDIS_HOST=host-gateway
REDIS_PASS=
REDIS_DB_NUMBER=0
REDIS_PORT=6379

# Cluster and Redis flags
ENABLE_CLUSTER=True
ENABLE_REDIS=True

# Render docx and doc
ENABLE_DOC_RENDERING=False

# X Frame Options
X_FRAME_OPTIONS=DENY

REPORTES_API_INTERNAL=http://localhost:8000

# Theme settings (Available: axxon, gobierno, issirmax)
SITE_THEME=axxon

# Gotenberg settings
GOTENBERG_PORT=3000
GOTENBERG_API_INTERNAL=http://localhost:3000
GOTENBERG_API_ENABLE_BASIC_AUTH=false
GOTENBERG_API_BASIC_AUTH_USERNAME=test
GOTENBERG_API_BASIC_AUTH_PASSWORD=test

# OAuth 2.0 settings for acceso único
CODE_VERIFIER=xxxxxxxxxxxxxxxxxxxxxxxx
CODE_CHALLENGER_METHOD=S256
CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxx
CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
REDIRECT_URI_EXTERNAL=http://localhost:8001/oauth2/callback
PROVIDER_URL_INTERNAL=http://localhost:8000
PROVIDER_URL_EXTERNAL=http://localhost:8000
REDIRECT_URI_LOGOUT=http://localhost:8001/oauth2/successful-logout/
API_KEY_OAUTH2_PROVIDER=xxxxxxxxxxxxxxxxxxxxxxxx
ENABLE_OAUTH2_LOGIN=False

#Microsft OAuth2
MICROSOFT_APP_ID=xxxxxxxxxxxxxxxxxxxxxxxx
MICROSOFT_TENANT_ID=xxxxxxxxxxxxxxxxxxxxxxxx
MICROSOFT_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxx
MICROSOFT_REDIRECT_URI=http://localhost:8000/accounts/microsoft/login/callback/

# Discord OAuth2 Settings
DISCORD_GUILD_ID=xxxxxxxxxxxxxxxxxxxxxxxx
DISCORD_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxx
DISCORD_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
DISCORD_REDIRECT_URI=http://localhost:8000/callback/discord/
DISCORD_AUTH_URL=https://discord.com/oauth2/authorize
ALLOWED_ROLES=xxxxxxxxxxxxxxxxxxxxxxxx
DISCORD_API_URL=https://discord.com/api
